# ---------- 环境 ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 网络抓取缓存（可重新生成，体积大，不入库）----------
data/raw/*
!data/raw/.gitkeep

# ---------- 运行日志 ----------
logs/*
!logs/.gitkeep

# ---------- 临时文件 ----------
*.tmp
~$*
.DS_Store
Thumbs.db
tmp/
.env
.env.*
!.env.example
*.pem
*.key
.vscode/
.idea/

# ---------- 说明 ----------
# data/interim、data/processed、output/ 体积小且是交付物证据，保留入库
